{
  "displayName": "Homebridge De'Longhi Comfort",
  "name": "homebridge-delonghi-comfort",
  "version": "1.1.0",
  "description": "A Homebridge plugin for De'Longhi Comfort-connected PAC air conditioners.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "author": "Tom Willmot <tom@willmot.co.uk>",
  "homepage": "https://github.com/willmot/homebridge-delonghi-comfort",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmot/homebridge-delonghi-comfort.git"
  },
  "bugs": {
    "url": "https://github.com/willmot/homebridge-delonghi-comfort/issues"
  },
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "homebridge-plugin",
    "delonghi"
  ],
  "homebridge": {
    "pluginAlias": "DelonghiComfortPlatform",
    "platform": "DelonghiComfortPlatform"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "axios-cookiejar-support": "^5.0.5",
    "tough-cookie": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "homebridge": "^2.5.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  }
}
